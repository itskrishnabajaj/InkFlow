{
  "name": "aethelgard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Aethelgard — a living voxel-world simulation engine. Nothing is scripted; everything is caused.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.21",
    "@types/three": "^0.184.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
